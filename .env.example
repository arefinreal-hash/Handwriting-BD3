# GEMINI_API_KEY: Required for Gemini AI API calls if optional AI tools are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing admin, judge, and participant session tokens.
SESSION_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"

# ADMIN_SEED_PASSWORD: Initial password for seeded Super Admin (admin@hcfb.org.bd) on first DB initialization.
ADMIN_SEED_PASSWORD="CHANGE_THIS_INITIAL_ADMIN_PASSWORD"

# JUDGE_SEED_PASSWORD: Initial password for seeded Judge account (judge@hcfb.org.bd) on first DB initialization.
JUDGE_SEED_PASSWORD="CHANGE_THIS_INITIAL_JUDGE_PASSWORD"
